## Names starting with `prefix`, shortest first.
static func complete(prefix: String, limit: int) -> Array:
	var out: Array = []
	for k in DOCS:
		if k.begins_with(prefix):
			out.append(k)
	out.sort_custom(func(a, b): return a.length() < b.length() if a.length() != b.length() else a < b)
	return out.slice(0, limit)
